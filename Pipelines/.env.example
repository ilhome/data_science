# Source API (Frankfurter publishes ECB reference rates; no key needed)
FX_API_BASE_URL=https://api.frankfurter.dev/v1
FX_BASE_CURRENCY=USD
# Comma-separated list; leave empty for every published currency
FX_SYMBOLS=

# HTTP resilience inside a task (Airflow retries sit on top of this)
HTTP_TIMEOUT_SECONDS=10
HTTP_MAX_RETRIES=3

# Storage. Defaults: ./data and a SQLite file under it.
# DATA_DIR=/opt/project/data
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/warehouse

# Alerting
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
ALERT_ON_RETRY=true
AIRFLOW_BASE_URL=http://localhost:8080
